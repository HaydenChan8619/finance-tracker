# PostgreSQL Connection String (e.g. from Neon.tech)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Admin Authentication (Email and Password)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="your-secure-password"

# Random secret (at least 32 characters) for signing session cookies
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Application branding (Optional)
NEXT_PUBLIC_APP_NAME="Finance Tracker"


